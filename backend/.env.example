# Copy this file to .env and fill in the values (never commit the real .env).

# --- Required ---------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas free tier works well).
MONGO_URI=mongodb://127.0.0.1:27017/taskmate

# Secret used to sign login tokens. Use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional ---------------------------------------------------------------
PORT=5000

# Comma separated list of browser origins allowed to call the API.
# Leave unset (or "*") to allow any origin. In production, set it to your frontend URL:
# CORS_ORIGIN=https://your-site.netlify.app
CORS_ORIGIN=http://localhost:5173

# Token lifetime (any value accepted by the jsonwebtoken package: 1d, 12h, ...).
JWT_EXPIRES_IN=1d

# One-click sample workspace for visitors. Each one expires automatically.
DEMO_ENABLED=true
DEMO_TTL_HOURS=24

# Rate limiting (requests per 15 minute window per IP unless stated).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_DEMO_MAX=10
