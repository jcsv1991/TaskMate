# Copy to .env.local to override. None of these are required in development.

# Where the API lives in a production build. Defaults to the hosted API.
# VITE_API_URL=https://taskmate-2njo.onrender.com/api

# In development the Vite server proxies /api to this address (default http://localhost:5000).
# VITE_PROXY_TARGET=http://localhost:5000

# ISO 4217 currency code used to format money (default USD).
# VITE_CURRENCY=USD
